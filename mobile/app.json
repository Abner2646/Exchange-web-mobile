{
  "expo": {
    "scheme": "cryptoexchange",
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "*.cryptoexchange.app",
              "pathPrefix": "/auth-success"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "associatedDomains": [
        "applinks:cryptoexchange.app"
      ]
    },
    "plugins": [
      "expo-web-browser"
    ]
  }
}
