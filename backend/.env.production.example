# ==========================================================================
# .env de PRODUCCIÓN — ejemplo para el deploy MVP (t3.micro, ~5 usuarios).
# COPIALO a backend/.env en el server y COMPLETÁ los <...>. NUNCA lo commitees
# con secretos reales, y NUNCA reutilices los valores de dev/test.
# La lista COMPLETA de variables está en backend/.env.template.
# ==========================================================================

NODE_ENV=production
PORT=3001
# Detrás del reverse proxy: que el backend NO escuche en la interfaz pública.
BIND_HOST=127.0.0.1

# ---- Auth (OBLIGATORIO: la app no arranca sin JWT_SECRET) ----
# Generá uno nuevo y fuerte: `openssl rand -hex 48`
JWT_SECRET=<GENERAR_UNO_NUEVO_LARGO_Y_ALEATORIO>
JWT_EXPIRES_IN=1h

# ---- Base de datos (Postgres en localhost, co-locado) ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=bitflow_prod
DB_USER=bitflow
DB_PASSWORD=<PASSWORD_FUERTE_DE_LA_DB>
# Postgres local SIN SSL → false (si fuera RDS u otra DB gestionada, dejalo en true).
DB_SSL=false
# Pool chico para instancia micro.
DB_POOL_MAX=5
DB_POOL_MIN=0

# ---- Cadencia de jobs (bajá el consumo con 5 usuarios) ----
ORDER_MATCH_INTERVAL_MS=3000
PRICE_UPDATE_INTERVAL_MS=60000
OUTBOX_PUBLISHER_INTERVAL_MS=15000
CONFIRMATION_UPDATE_INTERVAL_MS=120000
DEPOSIT_SCAN_INTERVAL_MS=300000
WITHDRAWAL_PROCESS_INTERVAL_MS=300000
REAPER_SWEEP_INTERVAL_MS=900000
RECONCILIATION_INTERVAL_MS=3600000
AML_SWEEP_INTERVAL_MS=3600000

# ---- CORS: el frontend se sirve desde el mismo origen (nginx) → normalmente no hace falta ----
# ALLOWED_ORIGINS=https://tu-dominio.com

# ---- Email (recomendado AWS SES en prod; a bajo volumen ~gratis) ----
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USER=<SMTP_USER>
EMAIL_PASS=<SMTP_PASS>

# ---- Blockchain / custodia ----
# MVP recomendado: TESTNET, y SIN claves de custodia mainnet en un .env plano
# (las claves reales van con AWS KMS, pendiente). Copiá las vars exactas de
# backend/.env.template (BTC_NETWORK, *_RPC, ETHERSCAN_API_KEY, BTC_PRIVATE_KEY, etc.)
# y dejalas en testnet / vacías hasta tener KMS. Sin claves, los retiros quedan deshabilitados.
