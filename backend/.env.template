# .env.example
# Copia este archivo a `.env` y completa los valores reales en tu entorno local / vault.
# NO subir `.env` al repositorio. Añadir `.env` a .gitignore.

# ==============================================================
# CONFIGURACIÓN GENERAL
# ==============================================================
SECRET_WORD=your_secret_word_here
EXPIRES_IN=24h
LOGIN_PASSWORD=your_login_password_here

# Database
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_HOST=localhost
DB_PORT=5432
# Production TLS to Postgres: the server certificate is validated by default.
# Supply the provider CA bundle (e.g. the AWS RDS global bundle, as a PEM string)
# to keep validation on with a managed DB.
# DB_SSL_CA=
# Escape hatch ONLY — set to false to DISABLE certificate validation (insecure,
# opens a MITM window on the DB connection). Prefer DB_SSL_CA instead.
# DB_SSL_REJECT_UNAUTHORIZED=true

# Enviroment
NODE_ENV=development

# JWT configuration
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1h

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# GOOGLE
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
SESSION_SECRET=your_session_secret

# ==============================================================
# CONFIGURACIÓN DE WALLETS
# ==============================================================

# ETH Sepolia
ETH_MNEMONIC=your_eth_mnemonic
ETH_PRIVATE_KEY=your_eth_private_key
ETH_ADDRESS=your_eth_address
# ETH_XPUB no hace falta: se deriva de ETH_MNEMONIC en tiempo de ejecución.

# BSC Testnet
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BNB_PRIVATE_KEY=your_bnb_private_key

# ==============================================================
# CONFIGURACIÓN DE JOBS AUTOMÁTICOS
# ==============================================================

DEPOSIT_SCAN_INTERVAL=1
CONFIRMATION_UPDATE_INTERVAL=1
WITHDRAWAL_PROCESS_INTERVAL=3
CLEANUP_INTERVAL_HOURS=1
HEALTH_CHECK_INTERVAL=10

# ==============================================================
# CONFIGURACIÓN DE BLOCKCHAIN ESPECÍFICA
# ==============================================================

ETH_REQUIRED_CONFIRMATIONS=3
BSC_REQUIRED_CONFIRMATIONS=6
BTC_REQUIRED_CONFIRMATIONS=3

ETH_DEFAULT_GAS_LIMIT=21000
ETH_DEFAULT_GAS_PRICE=20000000000
BSC_DEFAULT_GAS_LIMIT=21000
BSC_DEFAULT_GAS_PRICE=10000000000

MIN_WITHDRAWAL_ETH=0.0
MIN_WITHDRAWAL_BNB=0.0
MIN_WITHDRAWAL_USDT=0

# ==============================================================
# CONFIGURACIÓN DE RATE LIMITING
# ==============================================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WITHDRAWAL_MAX=10
RATE_LIMIT_SCAN_MAX=5

# ==============================================================
# CONFIGURACIÓN DE LOGGING
# ==============================================================

LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/blockchain.log

# ==============================================================
# CONFIGURACIÓN DE DESARROLLO
# ==============================================================

NODE_ENV=development
PORT=3000
# To allow multiple origins, set ALLOWED_ORIGINS as comma-separated list, e.g.: 
# ALLOWED_ORIGINS=http://localhost:3000,https://exchange-backend-3.onrender.com
# If ALLOWED_ORIGINS is not set, FRONTEND_URL can be used for a single origin.

# ==============================================================
# CONFIGURACIÓN DE SEGURIDAD
# ==============================================================

ENCRYPTION_KEY=your_encryption_key
BCRYPT_SALT_ROUNDS=10

# ==============================================================
# CONFIGURACIÓN DE NOTIFICACIONES
# ==============================================================

ADMIN_EMAIL=your_admin_email@example.com
NOTIFICATION_WEBHOOK_URL=https://your-webhook-url.com/notifications

# ==============================================================
# CONFIGURACIÓN DE PROVEEDORES EXTERNOS
# ==============================================================

MORALIS_API_KEY=your_moralis_api_key

# ==============================================================
# CONFIGURACIÓN DE CACHE
# ==============================================================

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

CACHE_TTL_BALANCE=300
CACHE_TTL_TRANSACTION=60

# ==============================================================
# CONFIGURACIÓN DE MONITOREO
# ==============================================================

SENTRY_DSN=your_sentry_dsn
ENABLE_METRICS=true
METRICS_PORT=9090

# ==============================================================
# CONFIGURACIÓN DE RESPALDO
# ==============================================================

ENABLE_BACKUP=true
BACKUP_INTERVAL_HOURS=24
BACKUP_PATH=./backups/

# ==============================================================
# CONFIGURACIÓN ESPECÍFICA POR AMBIENTE
# ==============================================================

# Desarrollo: usar testnets
# Producción: usar mainnets
# Ethereum Mainnet: https://mainnet.infura.io/v3/YOUR_PROJECT_ID
# BSC Mainnet: https://bsc-dataseed1.binance.org:443

# ==============================================================
# CONFIGURACIÓN DE FEES
# ==============================================================

EXCHANGE_FEE_PERCENTAGE=0.1
ENABLE_DYNAMIC_FEES=true
PEAK_HOURS_FEE_MULTIPLIER=1.5

# ==============================================================
# CONFIGURACIÓN DE WALLETS MAESTRAS
# ==============================================================

ETH_MASTER_WALLET_MIN_BALANCE=0
BNB_MASTER_WALLET_MIN_BALANCE=0

# ==============================================================
# CONFIGURACIÓN DE TESTING
# ==============================================================

USE_BLOCKCHAIN_SIMULATION=true
SIMULATE_NETWORK_DELAY=true
NETWORK_DELAY_MS=2000

# ==============================================================
# CONFIGURACIÓN DE TOKENS ERC-20
# ==============================================================

# USDT_CONTRACT_ADDRESS_ETH=your_usdt_contract_address
# USDC_CONTRACT_ADDRESS_ETH=your_usdc_contract_address

USDT_DECIMALS=6
USDC_DECIMALS=6

# ==============================================================
# NUEVAS CONFIGURACIONES
# ==============================================================

DEPOSIT_SCAN_INTERVAL_MS=60000
CONFIRMATION_UPDATE_INTERVAL_MS=30000
WITHDRAWAL_PROCESS_INTERVAL_MS=120000

MAX_PENDING_WITHDRAWALS_PER_USER=0
MIN_WITHDRAWAL_AMOUNT_USD=0

MAX_BLOCKCHAIN_RETRIES=3
BLOCKCHAIN_RETRY_DELAY_MS=5000

SYSTEM_HOT_WALLET_ETH=
SYSTEM_HOT_WALLET_BSC=
SYSTEM_HOT_WALLET_BTC=

BLOCKCHAIN_LOG_LEVEL=debug
BLOCKCHAIN_LOG_FILE=./logs/blockchain-transactions.log

DEPOSIT_NOTIFICATION_WEBHOOK=
WITHDRAWAL_NOTIFICATION_WEBHOOK=

BLOCKCHAIN_CACHE_TTL_SECONDS=30
ADDRESS_BALANCE_CACHE_TTL_SECONDS=60

# ==============================================================
# CONFIGURACIÓN TESTNET
# ==============================================================

ETHEREUM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key
ETHERSCAN_API_KEY=your_etherscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key
BSC_REQUIRED_CONFIRMATIONS=3

LAST_PROCESSED_BLOCK_ETH=0
LAST_PROCESSED_BLOCK_BSC=0
LAST_PROCESSED_BLOCK_BTC=0

# ==============================================================
# BITCOIN
# ==============================================================

BITCOIN_NETWORK=testnet3
BTC_PRIVATE_KEY=your_btc_private_key
BITCOIN_WALLET_ADDRESS=your_btc_wallet_address
BITCOIN_API_URL=https://blockstream.info/testnet/api
BITCOIN_RPC_URL=https://blockstream.info/api
BTC_FEE_PER_BYTE=10

# ==============================================================
# NOTAS IMPORTANTES
# ==============================================================

# 1. En producción, usar variables de entorno del sistema o vault de secrets.
# 2. Usar diferentes wallets para testnet y mainnet.
# 3. Nunca subas tu .env real al repo, solo este .env.example.
# 4. Si alguna clave fue subida, rota los secretos inmediatamente.
